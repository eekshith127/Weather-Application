<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather App</title> 
    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"> 

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Google Fonts: Space Grotesk (display) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/styles/main.css">
</head>

<body class="page-home">
    <header class="site-header">
        <div class="container site-header__inner"> <a href="/" class="brand">
                <span class="brand__mark" aria-hidden="true"> <img
                        src="/images/weather_icon.svg" alt="" height="40">
                </span> Weather App </a> </div>
    </header>

    <main class="home-hero">
        <div class="home-hero__atmosphere" aria-hidden="true"> <span
                class="blob blob--one"></span> <span
                class="blob blob--two"></span> 
        </div>

        <div class="container">
            <div class="home-card mx-auto"> <span class="eyebrow"><i
                        class="bi bi-broadcast"></i> Live forecast</span>
                <h1 class="home-card__title">How's the weather out there?</h1>
                <p class="home-card__subtitle">Enter a location and get an
                    instant, detailed weather snapshot.</p>
                <form action="/get-weather" method="post" class="location-form"
                    novalidate>
                    <div class="form-field mb-3"> <label for="cityInput"
                            class="form-label">City</label>
                        <div class="input-with-icon"> <i class="bi bi-geo-alt"
                                aria-hidden="true"></i> <input type="text"
                                class="form-control" id="cityInput" name="city"
                                placeholder="e.g., Vijayawada" required> 
                        </div>
                    </div>
                    <div class="form-field mb-3"> <label for="stateInput"
                            class="form-label">State</label>
                        <div class="input-with-icon"> <i class="bi bi-map"
                                aria-hidden="true"></i> <input type="text"
                                class="form-control" id="stateInput"
                                name="state" placeholder="e.g., Andhra Pradesh">
                        </div>
                    </div>
                    <div class="form-field mb-4"> <label for="countryInput"
                            class="form-label">Country</label>
                        <div class="input-with-icon"> <i class="bi bi-flag"
                                aria-hidden="true"></i> <input type="text"
                                class="form-control" id="countryInput"
                                name="country" placeholder="e.g., India"> 
                        </div>
                    </div> 
                    
                    <button id="post" class="btn-submit w-100"
                        type="submit"> Get weather info <i
                            class="bi bi-arrow-right"></i> 
                    </button>
                </form>
            </div>
        </div>
    </main>
    <%- include("partial/footer.ejs") %>